---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import { CATEGORY_NAMES, slugOf } from '../data/site';

interface Props {
  article: CollectionEntry<'articles'>;
  showBody?: boolean;
  detailLink?: boolean;
  ctaPosition?: string;
}

const { article, showBody = false, detailLink = true, ctaPosition = 'card' } = Astro.props;
const { data } = article;
const { Content } = await render(article);
const slug = slugOf(article.id);
const articleUrl = `/mea-ranking/articles/${slug}/`;
const IMG_DIMS: Record<string, [number, number]> = {"/images/banner-freecash.jpg": [3200, 800], "/images/banner-muse.jpg": [3840, 640], "/images/banner-official-hapitas.png": [561, 129], "/images/banner-official-moppy.jpg": [234, 60], "/images/banner-official-warau.png": [234, 60], "/images/hero.jpg": [1179, 393]};
const imgSize = data.image ? IMG_DIMS[data.image] : undefined;
---

<article class="service-card" id={slug}>
  <div class="card-tags">
    <span class="card-tag">{CATEGORY_NAMES[data.category] ?? data.category}</span>
  </div>
  <h3>
    <a href={articleUrl}>{data.service}</a>
  </h3>
  <div class="benefit-badge">
    <span class="benefit-label">登録者特典</span>
    <span class="benefit-value">{data.benefit}</span>
  </div>
  <p class="desc">{data.description}</p>
  {data.points && (
    <ul class="points">
      {data.points.map((p) => <li>{p}</li>)}
    </ul>
  )}
  {data.image && (
    <img class="banner" src={'/mea-ranking' + data.image} alt={data.imageAlt ?? `${data.service}の紹介バナー`} loading="lazy" decoding="async" width={imgSize?.[0]} height={imgSize?.[1]} />
  )}
  {data.code ? (
    <div class="code-row">
      <code>{data.code}</code>
      <button class="copy-btn" type="button" data-copy={data.code} data-service={slug}>
        <span class="copy-label">コピー</span>
      </button>
    </div>
  ) : (
    <p class="conditions">紹介コードはありません。紹介リンクから登録してください。</p>
  )}
  {showBody && <Content />}
  {data.url ? (
    <a class="register-btn" href={data.url} target="_blank" rel="sponsored noopener" data-service={slug} data-position={ctaPosition}>
      無料で登録する
    </a>
  ) : data.officialSite ? (
    <a class="register-btn" href={data.officialSite} target="_blank" rel="noopener" data-service={slug} data-position={ctaPosition}>
      公式サイトを見る
    </a>
  ) : (
    <p class="conditions">※{data.service}は招待コードのみの紹介です。アプリ・サイト内でコードを入力してください。</p>
  )}
  {detailLink && (
    <a class="detail-link" href={articleUrl}>詳細と条件を確認する</a>
  )}
  {data.prNote && <p class="pr-note">{data.prNote}</p>}
</article>
